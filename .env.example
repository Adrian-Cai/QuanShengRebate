# 券省 V1.2 环境变量模板。复制为 .env 后由进程、容器或部署平台注入；服务本身不会自动读取 .env 文件。
# 绝不把真实 App Secret / productRefKey 写进仓库、镜像、日志或聊天；.env 已被 .gitignore 忽略。
# G0 必须先在淘宝联盟控制台实测确认应用角色、权限包、material_id、推广位与网关，再填写下列值。

# 数据源：live=真实淘宝联盟调用；fixture=离线合成测试数据源（仅测试/CI，绝不用于生产）
QUANSHENG_UPSTREAM=live
PORT=3000

# --- 淘宝联盟（本次唯一开放的平台）---
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
# 推广位 PID 的末段数字 adzone_id（mm_<site_id>_<...>_<adzone_id>）
TAOBAO_ADZONE_ID=
# 精选/物料接口需要 site_id；若账号不提供可留空
TAOBAO_SITE_ID=
# 只允许固定白名单内的官方 TOP 网关；G0 按账号实测确认
TAOBAO_GATEWAY=https://gw.api.taobao.com/router/rest
# md5 或 hmac，按账号实测确认
TAOBAO_SIGN_METHOD=md5
# 首页推荐物料 ID（账号相关，不写死公开文档候选值）
TAOBAO_MATERIAL_ID_RECOMMEND=
# 关键词搜索物料 ID，可选；留空时不向搜索接口透传该参数
TAOBAO_MATERIAL_ID_SEARCH=

# --- 本站参数 ---
# 服务端 HMAC 密钥，用于 productRef 与 nextCursor 签名；请使用随机长字符串
QUANSHENG_PRODUCT_REF_KEY=
# 短缓存 TTL，范围 30000–120000 毫秒，默认 45000
QUANSHENG_CACHE_TTL_MS=45000
# 上游超时，范围 1000–30000 毫秒，默认 8000
QUANSHENG_UPSTREAM_TIMEOUT_MS=8000

# --- 京东联盟 / 多多进宝：未开放，无需配置，页面 tab 已置灰标注「未开放」---
