px;color:#a3947c;line-height:1.6;margin-top:9rpx}.buy{font-size:22rpx;color:#b4855e;border:1rpx solid #ead6be;border-radius:7rpx;text-align:center;padding:9rpx;margin-top:17rpx;background:#fffaf3}.loading,.empty{padding:50rpx 0;text-align:center;font-size:24rpx;color:#ac9c7d}.error{padding:30rpx;border:1rpx solid #e8c9bd;background:#fff8f4;border-radius:14rpx;font-size:22rpx;color:#9c8a72;line-height:1.9}.error-UPSTREAM_TIMEOUT,.error-UPSTREAM_RATE_LIMITED{border-color:#e7c98d;background:#fffaf0}.error button{display:inline;padding-left:20rpx;text-decoration:underline}.load-more{font-size:23rpx;color:#b4855e;background:#fffaf3;border:1rpx solid #ead6be;border-radius:12rpx;padding:18rpx;margin:10rpx 0 30rpx}.footer-note{font-size:19rpx;color:#b0a38b;line-height:1.9;margin:0 0 40rpx}
