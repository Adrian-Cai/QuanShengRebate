<view class="page">
  <view class="brand-row"><view class="brand"><image src="/assets/logo.png"/>券省</view><button class="guide" bindtap="guide">使用说明 ↗</button></view>
  <view class="hero"><text class="kicker">把日子过好，把钱花巧</text><view class="hero-title">每一次心动，<view>都可以<text>更划算。</text></view></view><view class="hero-note">淘宝联盟实时商品，价格以平台结算页为准。</view><image class="hero-art" src="/assets/kettle.png" mode="aspectFit"/></view>
  <view class="search"><input value="{{query}}" bindinput="onInput" bindconfirm="search" confirm-type="search" maxlength="2000" placeholder="搜商品，或粘贴商品链接"/><button bindtap="search">查券省钱 →</button></view>
  <view class="platform-line">淘宝联盟 · 已接入 <text>·</text> 京东联盟 · 未开放 <text>·</text> 多多进宝 · 未开放</view>
  <view class="steps"><view><text>01</text>浏览真实商品</view><text>→</text><view><text>02</text>看清价格口径</view><text>→</text><view><text>03</text>等待转链接入</view></view>
  <view class="heading"><text class="kicker">THE EDIT</text><view>今天，省一点好生活 <text>✳</text></view></view>
  <view class="scenes"><button class="scene peach" bindtap="scene" data-id="daily"><text>日常囤货</text><view>小预算，<view>大满足。</view></view><image src="/assets/tissue.png" mode="aspectFit"/></button><button class="scene sage" bindtap="scene" data-id="home"><text>品质居家</text><view>宅家也有<view>幸福感。</view></view><image src="/assets/lamp.png" mode="aspectFit"/></button><button class="scene lilac" bindtap="scene" data-id="digital"><text>通勤好物</text><view>好搭子，<view>刚刚好。</view></view><image src="/assets/headphones.png" mode="aspectFit"/></button></view>
  <view class="heading"><text class="kicker">LITTLE FINDS, BIG JOY</text><view>值得入手的好物</view></view>
  <view class="source-note">淘宝联盟实时返回 · 正式转链待接入</view>
  <view class="data-notice" wx:if="{{notice}}">{{notice}}</view>
  <view class="platform-tabs"><button wx:for="{{platforms}}" wx:key="id" data-id="{{item.id}}" bindtap="platform" disabled="{{!item.enabled}}" class="{{platform===item.id?'active':''}} {{item.enabled?'':'disabled-tab'}}">{{item.name}}</button></view>
  <scroll-view scroll-x class="categories"><button wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="category" class="{{category===item.id?'active':''}}">{{item.name}}</button></scroll-view>
  <view class="muted loading" wx:if="{{loading}}">正在加载淘宝联盟商品…</view>
  <view class="error error-{{errorKind}}" wx:if="{{error}}"><view>{{error}}</view><button bindtap="retry">重试</button></view>
  <view class="grid" wx:if="{{!loading}}">
    <button class="product" wx:for="{{products}}" wx:key="productRef" data-ref="{{item.productRef}}" bindtap="product">
      <view class="product-image"><image src="{{item.imagePath}}" mode="aspectFit"/></view>
      <view class="product-body">
        <view class="store platform-{{item.platform}}">{{item.platformName}} · {{item.store || '淘宝联盟商品'}}</view>
        <view class="product-title">{{item.title}}</view>
        <view class="coupon">{{item.couponText}}</view>
        <view class="coupon-condition" wx:if="{{item.couponConditions}}">{{item.couponConditions}}</view>
        <view class="price-row"><text class="price">¥{{item.priceLabel}}</text><text class="after">{{item.priceCaption}}</text><text class="old" wx:if="{{item.showOriginal}}">¥{{item.originalLabel}}</text></view>
        <view class="basis basis-{{item.priceBasis}}">{{item.basisLabel}}</view>
        <view class="price-note" wx:if="{{item.priceNote}}">{{item.priceNote}}</view>
        <view class="buy">查看详情 →</view>
      </view>
    </button>
  </view>
  <view wx:if="{{!loading && !products.length && !error}}" class="empty">暂时没有找到，换个关键词试试。</view>
  <button class="load-more" wx:if="{{nextCursor && !loading}}" bindtap="loadMore">加载更多 ↓</button>
  <view class="footer-note">当前仅接入淘宝联盟。正式转链与领券购买入口（/api/v1/conversions）待接入，商品卡不可购买。</view>
</view>
