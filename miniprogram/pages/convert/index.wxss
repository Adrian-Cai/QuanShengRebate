.intro{padding:5rpx 0 40rpx}.intro>view{font-size:58rpx;font-weight:650;margin-top:15rpx}.intro>view>text{color:#ed6743}.intro>.subtitle{font-size:24rpx;font-weight:400;color:#a59a85;margin-top:17rpx}.card{background:#fff;border:1rpx solid #eae3d6;border-radius:23rpx;padding:33rpx;box-shadow:0 12rpx 40rpx #554a3206}.card-title{display:flex;justify-content:space-between;align-items:center;font-size:30rpx;font-weight:550;gap:20rpx}.pill{font-weight:400;white-space:nowrap}.label{font-size:24rpx;color:#9c8d71;margin:30rpx 0 15rpx}textarea{width:100%;height:260rpx;border:1rpx solid #e8dfce;border-radius:15rpx;background:#fffdf8;font-size:25rpx;line-height:1.9;padding:22rpx}.input-tools{display:flex;gap:22rpx;align-items:center;margin:15rpx 0 30rpx;font-size:20rpx;color:#b19c7a}.input-tools>text{flex:1}.input-tools button{font-size:21rpx;color:#a27c50}.primary{background:#ed6743;color:#fff;border-radius:15rpx;font-size:25rpx;padding:20rpx}.error{margin-bottom:20rpx;color:#b3603f;font-size:22rpx;line-height:1.8}.status-notice{display:flex;gap:12rpx;background:#f8f6ef;border-radius:12rpx;padding:18rpx;margin-top:26rpx;font-size:20rpx;color:#a1967e;line-height:1.8}.status-notice>text{font-size:26rpx;line-height:1.4}.status-notice>view{flex:1}.result{margin-top:30rpx}.result-label{font-size:21rpx;color:#b39d78;padding-bottom:20rpx;border-bottom:1rpx solid #e9e0ce}.unknown{padding:26rpx 0 0}.unknown>view{font-size:28rpx;margin-bottom:12rpx}.unknown>text{font-size:23rpx;color:#a49478;line-height:1.9}.facts{display:flex;gap:16rpx;margin:28rpx 0}.facts>view{flex:1;background:#f8f5ed;border-radius:12rpx;padding:18rpx;font-size:19rpx;color:#a1967e}.facts .fact-value{display:block;font-size:23rpx;color:#7d705a;margin-top:8rpx}.secondary{border:1rpx solid #e4d3b8;border-radius:15rpx;color:#b29163;background:#fffaf3;font-size:23rpx;padding:18rpx}.how{background:#f3f0e6;border-radius:20rpx;padding:32rpx;margin-top:40rpx}.how-title{font-size:34rpx;margin:10rpx 0 26rpx}.how>view:not(.how-title){font-size:25rpx;margin-top:22rpx;color:#8e7e5f}.how>text:last-child{display:block;border-top:1rpx solid #dfd4bc;padding-top:23rpx;margin-top:25rpx;font-size:21rpx;color:#ad9a75;line-height:1.8}
