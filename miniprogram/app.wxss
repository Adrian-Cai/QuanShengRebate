page{background:#fffdfa;color:#292a26;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:26rpx;line-height:1.65}view,text,input,textarea,button{box-sizing:border-box}button{font-size:26rpx;line-height:1.5;background:transparent;border:0;padding:0;margin:0;border-radius:0;color:inherit}button::after{border:0}button[disabled]{opacity:.5}image{display:block}.page{padding:32rpx}.muted{color:#a09683}.primary{background:#ed6743;color:white;padding:23rpx 25rpx;border-radius:15rpx;font-size:26rpx;text-align:center}.kicker{font-size:18rpx;letter-spacing:3rpx;color:#ac9d81}.pill{font-size:18rpx;color:#a17d56;background:#f8efdf;border-radius:8rpx;padding:3rpx 9rpx}.demo-note{padding:20rpx;background:#f6f1e7;border:1rpx solid #eae2d3;border-radius:12rpx;font-size:21rpx;color:#a09376;line-height:1.9}.brand{font-size:38rpx;font-weight:650;letter-spacing:2rpx;display:flex;align-items:center;gap:14rpx}.brand image{width:62rpx;height:62rpx}.platform-taobao{color:#e87935}.platform-jd{color:#d96154}.platform-pdd{color:#da624d}.error{font-size:23rpx;color:#c65a3e;margin-top:14rpx}
